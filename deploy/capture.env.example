# /etc/lensai/capture.env  — copy from this template, fill in, chmod 640 root:lensai.
# Secrets live on the BOX and are NEVER committed to the repo.

# Corpus location (absolute; the daemon is the single writer).
CAPTURE_DB_PATH=/var/lib/lensai/capture.db
CAPTURE_TICK_MS=15000

# FRED macro key (DXY proxy DTWEXBGS, 10y DGS10). Free:
# https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, macro jobs record an ingest_runs error (visible in tail), never fake data.
FRED_API_KEY=

# ── Backup ──────────────────────────────────────────────────────────────────
# Preferred: litestream (see deploy/litestream.yml). If you use the cron fallback
# (deploy/backup.sh), set a snapshot dir AND one off-machine target:
CAPTURE_BACKUP_DIR=/var/lib/lensai/backups
# BACKUP_S3_URI=s3://your-bucket/lensai/snapshots
# BACKUP_RCLONE_REMOTE=remote:lensai/snapshots
