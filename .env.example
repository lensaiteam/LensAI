# ─────────────────────────────────────────────────────────────
# LensAI environment (CLAUDE.md §14). Copy to .env.local and fill in.
# ALL of these are server-side only except the NEXT_PUBLIC_* ones.
# ─────────────────────────────────────────────────────────────

# ── LLM provider (swappable — all model access is behind src/lib/ai/provider) ──
# Switching provider is a config change, not a refactor. Set LLM_PROVIDER and the
# matching API key + model ids below.
LLM_PROVIDER=gemini
ANALYSIS_MODEL=gemini-2.5-flash
CHAT_MODEL=gemini-2.5-flash

# Gemini (Google AI Studio free tier) — used when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Anthropic — production swap-in; used when LLM_PROVIDER=anthropic
# (then set ANALYSIS_MODEL=claude-sonnet-4-6 and CHAT_MODEL=claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Supabase (service-role key is server-only — NEVER expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Market data
COINBASE_API_BASE=https://api.exchange.coinbase.com
FALLBACK_MARKET_DATA_BASE=https://api.coingecko.com/api/v3
FALLBACK_MARKET_DATA_API_KEY=        # CoinGecko demo/pro key (optional; blank = public rate limits)

# News (optional pre-fetch source for top tokens)
NEWS_API_KEY=
NEWS_API_BASE=

# App / session
SESSION_JWT_SECRET=                   # random 32+ byte secret for the session cookie
APP_DOMAIN=localhost:3000             # SIWE domain check — must match the browser origin host
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_ID=        # RainbowKit/WalletConnect project id

# Background precompute job (protects the /api/cron/precompute endpoint)
CRON_SECRET=
