# ─────────────────────────────────────────────────────────────
# LensAI environment (spec §14). Copy to .env.local and fill in.
# ALL of these are server-side only except the NEXT_PUBLIC_* ones.
# ─────────────────────────────────────────────────────────────

# ── LLM provider (swappable — all model access is behind src/lib/ai/provider) ──
# Switching provider is a config change, not a refactor. Set LLM_PROVIDER and the
# matching API key + model ids below.
LLM_PROVIDER=gemini
ANALYSIS_MODEL=gemini-2.5-flash
CHAT_MODEL=gemini-2.5-flash

# Gemini (Google AI Studio free tier) — used when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Anthropic — production swap-in; used when LLM_PROVIDER=anthropic
# (then set ANALYSIS_MODEL=claude-sonnet-4-6 and CHAT_MODEL=claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Supabase (service-role key is server-only — NEVER expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Market data
COINBASE_API_BASE=https://api.exchange.coinbase.com
FALLBACK_MARKET_DATA_BASE=https://api.coingecko.com/api/v3
FALLBACK_MARKET_DATA_API_KEY=        # CoinGecko demo/pro key (optional; blank = public rate limits)

# News (optional pre-fetch source for top tokens)
NEWS_API_KEY=
NEWS_API_BASE=

# App / session
SESSION_JWT_SECRET=                   # random 32+ byte secret for the session cookie
APP_DOMAIN=localhost:3000             # SIWE domain check — must match the browser origin host
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_ID=        # RainbowKit/WalletConnect project id

# Background precompute job (protects the /api/cron/precompute endpoint)
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# CAPTURE LAYER (v2 Research Desk — Phase 1). See spec + KEYS_NEEDED.md.
# The capture daemon is a SEPARATE, always-on process from the web app and does
# NOT use Supabase. Its immutable corpus is a local SQLite file — the moat — and
# MUST be backed up off-machine (README §Backup). None of these are NEXT_PUBLIC.
# ─────────────────────────────────────────────────────────────
CAPTURE_DB_PATH=./data/capture.db     # SQLite corpus file (gitignored)
CAPTURE_TICK_MS=15000                 # scheduler loop interval (ms)

# FRED — macro: DXY proxy DTWEXBGS + 10y DGS10. Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Backup — the corpus is a single point of failure; configure ONE:
LITESTREAM_REPLICA_URL=               # e.g. s3://bucket/capture (continuous replication)
CAPTURE_BACKUP_DIR=                   # else: dir for scheduled `sqlite3 .backup` snapshots

# Stubbed institutional sources — Phase 1 defines the interface only and NEVER
# fabricates data. Leave blank until credentials exist. See KEYS_NEEDED.md.
ETF_FLOWS_API_KEY=
INSTITUTIONAL_DEPTH_API_KEY=
